{
  "hosting": {
    "public": "build",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|svg|ico|mp4)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/gaming-event-party",
        "destination": "/gaming-events",
        "type": 301
      },
      {
        "source": "/product-page/:path*",
        "destination": "/movie-nights",
        "type": 301
      },
      {
        "source": "/video-gaming-events",
        "destination": "/gaming-events",
        "type": 301
      },
      {
        "source": "/outdoor-movie",
        "destination": "/movie-nights",
        "type": 301
      },
      {
        "source": "/art",
        "destination": "/novelties",
        "type": 301
      },
      {
        "source": "/360videobooth",
        "destination": "/photo-booth",
        "type": 301
      },
      {
        "source": "/360-video-booth",
        "destination": "/photo-booth",
        "type": 301
      },
      {
        "source": "/360-booth",
        "destination": "/photo-booth",
        "type": 301
      },
      {
        "source": "/just-dance-party",
        "destination": "/just-dance",
        "type": 301
      },
      {
        "source": "/copy-of-glow-park",
        "destination": "/glow-park",
        "type": 301
      },
      {
        "source": "/copy-of-exiciting-new-offer",
        "destination": "/glow-park",
        "type": 301
      },
      {
        "source": "/sim-racing-experience",
        "destination": "/sim-racing",
        "type": 301
      },
      {
        "source": "/trivia-night",
        "destination": "/trivia-nights",
        "type": 301
      },
      {
        "source": "/movie-night",
        "destination": "/movie-nights",
        "type": 301
      },
      {
        "source": "/covid-19-information",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
